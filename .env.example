# Session JWT signing secret (min 16 chars). Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Seed «Создатель» (Creator) account — used for cabinet login.
# Demo defaults for local/testing:
CREATOR_USERNAME=creator
CREATOR_PASSWORD=change-me

# Optional: bcrypt hash instead of plaintext CREATOR_PASSWORD (not required for phase 1).
# CREATOR_PASSWORD_HASH=

# Vercel Blob — auto-injected when a Blob store is linked to the project.
# Locally: run `npx vercel env pull .env.local`
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Email (verification + password change) ---
# If RESEND_API_KEY is set, real emails are sent via Resend.
# RESEND_API_KEY=re_...
# EMAIL_FROM="DuneCraft <onboarding@resend.dev>"
#
# Stub mode (default when no Resend key): 6-digit codes are generated and
# returned once as `devCode` in the API response so you can complete the flow
# without SMTP. Force stub even with a key:
# EMAIL_STUB=1
#
# Codes are hashed and stored on the user record + dunecraft/auth-tokens.json (Blob).

# Legacy stub removed: ADMIN_STUB_PASSWORD is no longer used.
# Creator tools live in /cabinet (role=creator).

# Optional one-shot bootstrap (scripts/ensure-fsdf-creator.ts):
# ENSURE_CREATOR_USERNAME=fsdf
# ENSURE_CREATOR_PASSWORD=Fsdf123!
